menu "Soul Injector job scripts"

    config SI_JS_ENABLE
        bool "Run job scripts (JS)"
        depends on SPIRAM
        default n
        help
            Jobs may carry a bytecode script whose preProgram/postProgram
            hooks run around programming. Takes a PSRAM arena and a task.

    config SI_JS_ARENA_KB
        int "Script heap (KB of PSRAM)"
        range 512 8192
        default 2048
        help
            Everything a script allocates comes from here, nothing else.
            Reserved at boot.

    config SI_JS_TASK_STACK
        int "JS task stack (bytes, internal RAM)"
        range 8192 65536
        default 16384

    config SI_JS_TASK_PRIO
        int "JS task priority"
        range 1 20
        default 4
        help
            Below the programming, SIDP and power tasks, so a busy script
            can't hold them up.

    config SI_JS_TASK_CORE
        int "JS task core"
        range 0 1
        default 0

    config SI_JS_SLICE_MS
        int "Longest one turn of a script may run (ms)"
        range 10 10000
        default 200
        help
            One callback, or a batch of promise jobs. Waiting on the target
            doesn't count. Past it the script is stopped.

    config SI_JS_YIELD_MS
        int "Yield a busy script every (ms)"
        range 0 1000
        default 20

    config SI_JS_HOOK_TIMEOUT_MS
        int "Default hook timeout (ms)"
        range 100 600000
        default 30000
        help
            A job can set its own. Past it the hook fails and the run with it.

    config SI_JS_CALL_TIMEOUT_MS
        int "Default timeout of a sync target call (ms)"
        range 10 10000
        default 500

    config SI_JS_MAX_SCRIPT_KB
        int "Largest script (KB)"
        range 16 2048
        default 256

endmenu
