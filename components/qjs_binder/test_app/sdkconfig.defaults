CONFIG_SI_JS_ENABLE=y
CONFIG_SI_JS_CALL_TIMEOUT_MS=200
CONFIG_QJS_ESP_MOD_UDP=n
CONFIG_QJS_ESP_MOD_POSIX_SOCKET=n
CONFIG_QJS_ESP_BC_COMPILE=n
CONFIG_SI_JS_NETWORK=y
