# Soul Injector Rev 8 hardware defaults.
#
# ESP32-S31 GPIO assignments match Rev 7.1, except that GPIO2 is now the modem's
# MAIN_RI. The SWD/UART front end and the LCD moved to the adaptor board, reached
# through the 40-pin J1/J2 connector.
CONFIG_SI_DEVICE_BUILD="8"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# WiFi does not fit the 2 MB app partition of partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_rev8.csv"
CONFIG_SI_NETWORK_ENABLE=y
# Nothing is placed in PSRAM .bss. Allowed, it breaks the link once WiFi is in:
# ESP-IDF's .ext_ram.dummy section (PSRAM shares the bus with flash rodata) cannot
# move backwards past WiFi's NOLOAD log strings at the end of rodata.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=n
# TCP buffers larger than one 8 KiB SIDP frame, so a frame does not wait an extra
# round trip over WiFi (sdkconfig.defaults has 5744 for USB-only revisions).
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384

# NT279VJ-C10-01-V1 display, on the adaptor board.
CONFIG_SI_DISP_ENABLE=y
CONFIG_SI_DISP_PANEL_NT279VJ=y
CONFIG_SI_DISP_PANEL_IO_SCLK=53
CONFIG_SI_DISP_PANEL_IO_MOSI=54
CONFIG_SI_DISP_PANEL_IO_RST=51
CONFIG_SI_DISP_PANEL_IO_DC=52
CONFIG_SI_DISP_PANEL_IO_CS=50
CONFIG_SI_DISP_PANEL_BKL=55
# Active-low P-FET supply switch, pulled off. The firmware does not drive this
# option yet, so the LCD stays unpowered until it does.
CONFIG_SI_DISP_PANEL_PWR=39
CONFIG_SI_DISP_PANEL_BUFFER_SIZE=60776
CONFIG_SI_LED_ENABLE=n
CONFIG_SI_TARGET_DETECT_PIN=3
CONFIG_SI_USB_PLUG_DET_PIN=35
CONFIG_SI_TARGET_SWITCH_PIN=57
# The adaptor's power profiler uses INA226; this option is for the INA228 rig.
CONFIG_SI_SG_PROG_RIG=n

CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# Rev 8 fits SN74AVC2T245 translators. Their OE/DIR logic and pinout match the
# SN74AXC2T245 this PHY option is named after.
CONFIG_ESP_SWD_PHY_AXC2T245=y
CONFIG_ESP_SWD_CLK_PIN=10
CONFIG_ESP_SWD_DATA_OUT_PIN=16
CONFIG_ESP_SWD_DATA_IN_PIN=15
CONFIG_ESP_SWD_DATA_NOE_PIN=12
CONFIG_ESP_SWD_DATA_DIR1_PIN=14
CONFIG_ESP_SWD_DATA_DIR2_PIN=13
CONFIG_ESP_SWD_CLK_NOE_PIN=8
CONFIG_ESP_SWD_NRST_PIN=11
CONFIG_ESP_SWD_BOOT_PIN=9
# Direct SPI2 backend, with the settings measured on Rev 8 by the SWD hardware test.
CONFIG_ESP_SWD_DEFAULT_CLOCK_HZ=13000000
CONFIG_ESP_SWD_TURNAROUND_DELAY_US=0
CONFIG_ESP_SWD_TURNAROUND_DELAY_NS=10
CONFIG_ESP_SWD_USE_DEDICATED_GPIO=y
CONFIG_ESP_SWD_DEDICATED_TRANSLATOR_CONTROLS=y
CONFIG_ESP_SWD_USE_SPI=y

# UART link to ESP-family programming targets.
CONFIG_SI_ESP32_TARGET_UART_TX_PIN=6
CONFIG_SI_ESP32_TARGET_UART_RX_PIN=7

CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
# Keep the USB Serial/JTAG console alive while it is connected
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

CONFIG_LWIP_ENABLE_LCP_ECHO=y
CONFIG_LWIP_LCP_ECHOINTERVAL=20
CONFIG_LWIP_LCP_MAXECHOFAILS=5

# Power profiler on the adaptor: I2C SDA/SCL and the shared INA226 /ALERT,
# range latch data and clock, and the HIGH and MID latch readbacks.
CONFIG_SI_POWER_PROFILER_ENABLE=y
CONFIG_SI_POWER_PROF_SDA_PIN=17
CONFIG_SI_POWER_PROF_SCL_PIN=18
CONFIG_SI_POWER_PROF_ALERT_PIN=4
CONFIG_SI_POWER_PROF_RANGE_D_PIN=19
CONFIG_SI_POWER_PROF_RANGE_CLK_PIN=37
CONFIG_SI_POWER_PROF_HIGH_RB_PIN=38
CONFIG_SI_POWER_PROF_MID_RB_PIN=5

# Internal RAM: with WiFi on, the default leaves too little for the flasher
# task's stack. Small allocations may go to PSRAM (the flash driver copies
# PSRAM buffers through an internal one).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
