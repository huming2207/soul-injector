# Writes si_build_info.h with the commit the firmware is built from.
#
# Runs on every build (see main/CMakeLists.txt), not only at configure time, so
# the commit can't go stale after a commit or an edit. The header is rewritten
# only when its text changes, so an unchanged tree recompiles nothing.
#
# In:  SRC_DIR (the project root), OUT (the header to write)

set(commit "")
set(modified 0)

find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse --short=7 HEAD
        WORKING_DIRECTORY "${SRC_DIR}"
        OUTPUT_VARIABLE commit
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE rc
        ERROR_QUIET)
    if(NOT rc EQUAL 0)
        set(commit "")
    else()
        # Tracked files that differ from HEAD, submodules included (a moved
        # submodule, or changes inside one). Untracked files aren't counted:
        # build output and editor files would mark every build modified.
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
            WORKING_DIRECTORY "${SRC_DIR}"
            OUTPUT_VARIABLE changes
            RESULT_VARIABLE rc
            ERROR_QUIET)
        if(NOT rc EQUAL 0 OR NOT changes STREQUAL "")
            set(modified 1)
        endif()
    endif()
endif()

set(text "// Generated by main/build_info.cmake on every build. Don't edit.\n#pragma once\n\n#define SI_FW_COMMIT \"${commit}\"\n#define SI_FW_MODIFIED ${modified}\n")

if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
